---
import project from "@/configs/project";
---

<footer class="border-t border-neutral-200 bg-white py-4 dark:border-neutral-800 dark:bg-neutral-950">
  <div class="mx-auto max-w-7xl px-5 text-center">
    <p class="text-md text-neutral-500 dark:text-neutral-400">
      {project.name}@{project.version}
    </p>
    <p class="mt-1 text-md text-neutral-600 dark:text-neutral-300">
      Built by 
      <a 
        class="text-blue-600"
        href={project.social.github.url}
        target="_blank"
      >
        @{project.social.github.handle}
      </a> 
      with ❤️ for developers.
    </p>
  </div>
</footer>
