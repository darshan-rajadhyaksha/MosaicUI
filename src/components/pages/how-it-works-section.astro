---
const howItWorksCards = [
  {
    title: "Browse",
    description:
      "Explore a curated collection of creative, production-ready components built for modern web apps.",
  },
  {
    title: "Copy",
    description: "Copy the clean, well-structured code with a single click.",
  },
  {
    title: "Paste & Customize",
    description:
      "Paste it into your project, tweak the styles if needed, and you're ready to ship.",
  },
];
---

<div class="mx-auto max-w-7xl px-5 py-24 lg:py-28">
  <!-- Header -->
  <div class="max-w-2xl">
    <h2 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
      Build Faster in 3 Simple Steps
    </h2>

    <p class="mt-4 text-md sm:text-lg text-neutral-600 dark:text-neutral-400">
      No complex setup. Just clean React components ready to drop into your
      project. Works seamlessly with React, Next.js, and modern styling
      solutions.
    </p>
  </div>

  <!-- Cards -->
  <div class="mt-12 sm:mt-14 grid gap-6 md:grid-cols-3">
    {
      howItWorksCards.map((card, index) => (
        <div class="rounded-2xl border border-neutral-200 bg-white p-6 transition hover:-translate-y-1 hover:border-blue-500 hover:shadow-lg dark:border-neutral-800 dark:bg-neutral-900">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-600 text-sm font-semibold text-white">
            {index + 1}
          </div>
          <h3 class="mt-5 text-lg font-semibold text-neutral-900 dark:text-white">
            {card.title}
          </h3>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            {card.description}
          </p>
        </div>
      ))
    }
  </div>
</div>
