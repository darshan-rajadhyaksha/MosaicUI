---
import { Icon } from "astro-icon/components";
import project from "@/configs/project";
import ThemeToggleButton from "@/components/theme-toggle-button.astro";

const {
  showSidebarButton = true,
  className = "",
} = Astro.props;
---

<div class={`${className} w-full h-[64px] border-b border-b-neutral-200 dark:border-b-neutral-800 sticky top-0 left-0 z-[100] bg-white dark:bg-neutral-950`}>
  <div class="w-full h-full px-5 max-w-7xl mx-auto flex justify-between items-center">
    <div class="flex gap-4 items-center">
      {
        showSidebarButton && (
          <button
            aria-label="Open Sidebar"
            class="w-[32px] h-[32px] dark:text-neutral-300 cursor-pointer grid place-items-center"
            data-sidebar-toggle-button
          >
            <Icon name="sidebar" class="text-xl" />
          </button>   
        )
      }
      <a class="flex items-center gap-2 text-gray-900 dark:text-gray-100 font-bold" href="/">
        <img
          class="w-[24px]"
          src={project.logo.small}
          alt={`${project.name} Logo`}
        />
        <span>{project.name}</span>
      </a>
    </div>
    <div class="flex gap-2">
      <a 
        aria-label="X"
        href={project.social.x.url}
        target="_blank"
        rel="noreferrer noopener"
        class="w-[32px] h-[32px] grid place-items-center text-gray-900 dark:text-gray-100 text-lg hover:bg-zinc-200 dark:hover:bg-zinc-800 rounded-md cursor-pointer"
      >
        <Icon name="x" />
      </a>
      <a
        aria-label="Github"
        href={project.github}
        target="_blank"
        rel="noreferrer noopener"
        class="w-[32px] h-[32px] grid place-items-center text-gray-900 dark:text-gray-100 text-lg hover:bg-zinc-200 dark:hover:bg-zinc-800 rounded-md cursor-pointer"
      >
        <Icon name="github" />
      </a>   
      <ThemeToggleButton />
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const sidebarToggleBtns = document.querySelectorAll("button[data-sidebar-toggle-button]");
    sidebarToggleBtns.forEach(button => {
      button.addEventListener("click", () => {
        const sidebarEvent = new CustomEvent("sidebar-open");
        document.documentElement.dispatchEvent(sidebarEvent);
      });
    });
  });
</script>
