---
import BaseLayout from "@/layouts/base.astro";
import PageLayout from "@/layouts/page.astro";
import project from "@/configs/project";
import resolveProjectURL from "@/utils/resolve-project-url";

const title = "Introduction";

const meta = {
	title: `${title} | ${project.name}`,
	image: resolveProjectURL(`assets/index.jpg`),
	url: resolveProjectURL("introduction/"),
};
---

<BaseLayout meta={meta}>
  <PageLayout>
    <span slot="heading">Introduction</span>
    <span slot="description">
      Welcome to <span class="font-semibold text-zinc-900 dark:text-zinc-100">{project.name}</span>,
      a free and open-source collection of high-quality React components built with
      <span class="font-medium text-zinc-900 dark:text-zinc-100">Tailwind CSS</span> and
      <span class="font-medium text-zinc-900 dark:text-zinc-100">Motion</span>.
      These components are designed for modern React applications.
    </span>

    <!-- Features -->
    <section class="space-y-6">
      <div class="space-y-2">
        <h2 class="text-2xl font-semibold text-zinc-900 dark:text-zinc-100">
          How It Helps
        </h2>

        <p class="text-zinc-600 dark:text-zinc-400">
          We believe UI components should be flexible, not restrictive. Our components are built around four core pillars:
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">

        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 space-y-2">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">Fully Customizable</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Built with Tailwind CSS so you can easily adapt styles and layouts to match your design system.
          </p>
        </div>

        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 space-y-2">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">Modern React Practices</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Uses clean architecture and reusable patterns inspired by modern React development.
          </p>
        </div>

        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 space-y-2">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">Performance First</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Lightweight components with optimized rendering and smooth Motion animations.
          </p>
        </div>

        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 space-y-2">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">Accessibility (A11y)</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Built with keyboard navigation, focus states, and screen reader support in mind.
          </p>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-gradient-to-br from-zinc-50 to-white dark:from-zinc-900 dark:to-zinc-950 p-8">
      <!-- subtle glow decoration -->
      <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-blue-500/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-indigo-500/10 blur-3xl"></div>

      <div class="relative space-y-4">
        <h3 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          Ready to build?
        </h3>

        <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-xl">
          Check the Installation section to get started and begin building your next React UI with
          Tailwind CSS and Motion-powered components.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/installation/"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500 transition">
            View Installation
          </a>
          <a href="/components/"
            class="inline-flex items-center justify-center rounded-lg border border-zinc-300 dark:border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition">
            Browse Components
          </a>
        </div>
      </div>
    </section>
  </PageLayout>
</BaseLayout>