---
import BaseLayout from "@/layouts/base.astro";
import PageLayout from "@/layouts/page.astro";
import project from "@/configs/project";
import resolveProjectURL from "@/utils/resolve-project-url";
import cnCode from "@/utils/cn?raw";
import CodeBlock from "@/components/code-block.astro";

const title = "Installation";

const meta = {
	title: `${title} | ${project.name}`,
	image: resolveProjectURL(`assets/index.jpg`),
	url: resolveProjectURL("installation/"),
};
---

<BaseLayout meta={meta}>
  <PageLayout>
    <span slot="heading">
      Installation
    </span>

    <span slot="description">
      Follow these simple steps to add
      <span class="font-semibold text-zinc-900 dark:text-zinc-100">
        {project.name}
      </span>
      components to your React project.
    </span>

    <!-- Prerequisites -->
    <section class="space-y-6">
      <h2 class="text-2xl font-semibold text-zinc-900 dark:text-zinc-100">
        Prerequisites
      </h2>

      <p class="text-zinc-600 dark:text-zinc-400">
        Make sure you have 
        <span class="font-medium text-zinc-900 dark:text-zinc-100">Tailwind CSS (v4)</span>,
        <span class="font-medium text-zinc-900 dark:text-zinc-100">Motion</span>,
        <span class="font-medium text-zinc-900 dark:text-zinc-100">clsx</span> and
        <span class="font-medium text-zinc-900 dark:text-zinc-100">tailwind-merge</span> installed in your project.
      </p>

      <div>
        <CodeBlock
          code="npm install tailwindcss motion clsx tailwind-merge"
          lang="bash"
        />
      </div>

      <p class="text-zinc-600 dark:text-zinc-400">
        Add the utility function <span class="font-medium text-zinc-900 dark:text-zinc-100">cn</span> inside your utils folder.
      </p>

      <div>
        <CodeBlock
          fileName="/utils/cn.ts",
          code={cnCode}
          lang="tsx"
        />
      </div>
    </section>

    <!-- Steps -->
    <section class="space-y-6">

      <h2 class="text-2xl font-semibold text-zinc-900 dark:text-zinc-100">
        Steps
      </h2>

      <div class="space-y-6">

        <!-- Step 1 -->
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-5 space-y-2 bg-white dark:bg-zinc-900">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
            1. Choose a Component
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Browse the components library and select the component you want to use.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-5 space-y-2 bg-white dark:bg-zinc-900">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
            2. Install Dependencies
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Some components may require additional external dependencies. Install them before use.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-5 space-y-2 bg-white dark:bg-zinc-900">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
            3. Copy Component Code
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Copy the component source code into your project. You can modify it freely to fit your needs.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-5 space-y-2 bg-white dark:bg-zinc-900">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
            4. Use the Component
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Import and use the component in your project. Check the Props section for available customization options.
          </p>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-gradient-to-br from-zinc-50 to-white dark:from-zinc-900 dark:to-zinc-950 p-8">

      <!-- subtle glow decoration -->
      <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-blue-500/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-purple-500/10 blur-3xl"></div>

      <div class="relative space-y-4">
        <h3 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
          Ready to explore?
        </h3>

        <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-xl">
          Check the Components section to discover production-ready React UI components built with Tailwind CSS and Motion.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/components/"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500 transition">
            Browse Components 
          </a>
        </div>
      </div>
    </section>
  </PageLayout>
</BaseLayout>