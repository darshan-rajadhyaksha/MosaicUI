---
import BaseLayout from "@/layouts/base.astro";
import Navbar from "@/components/navbar.astro";
import HeroSection from "@/components/pages/hero-section.astro";
import FooterSection from "@/components/pages/footer-section.astro";
import HowItWorksSection from "@/components/pages/how-it-works-section.astro";
import FeatuesSection from "@/components/pages/features-section.astro";
import project from "@/configs/project";
import resolveProjectURL from "@/utils/resolve-project-url";

const meta = {
	title: `${project.name} - Beautiful React Components for Your Project`,
	image: resolveProjectURL(`assets/index.jpg`),
	url: resolveProjectURL(),
};
---

<BaseLayout meta={meta}>
	<Navbar showSidebarButton={false} />
	<HeroSection />
	<HowItWorksSection />
	<FeatuesSection />
	<FooterSection />
</BaseLayout>
